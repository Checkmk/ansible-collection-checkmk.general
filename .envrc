# -*- mode: sh -*-

layout_python() {
    # Honour a caller-provided UV_PROJECT_ENVIRONMENT and only default to .venv.
    # This directory is shared with the Vagrant box over virtiofs, and that box
    # uses .venv-vm, so overwriting the choice here would make it clobber the
    # host's environment (the interpreter paths differ per machine).
    # Using $PWD ensures we are working with an absolute path from the start,
    # preventing path-resolution mismatches in uv.
    # (not named VIRTUAL_ENV: a local of that name would shadow the variable
    # the activate script below exports, keeping it out of the shell.)
    local venv_path="${UV_PROJECT_ENVIRONMENT:-$PWD/.venv}"
    [[ "$venv_path" == /* ]] || venv_path="$PWD/$venv_path"

    # Tell uv to explicitly target this environment, before creating it:
    # uv sync needs to know where the environment lives.
    export UV_PROJECT_ENVIRONMENT="$venv_path"

    if [[ ! -d "$venv_path" ]]; then
        log_status "No virtual environment exists. Creating it."
        uv venv "$venv_path"
        uv sync
    fi

    # Activate the virtual environment
    # (The activate script natively exports VIRTUAL_ENV="$venv_path")
    . "$venv_path/bin/activate"
}

layout python
